# Rahasia produksi. Salin jadi `deploy/.env` lalu isi — berkas itu gitignored.
#
#   cp deploy/.env.example deploy/.env
#
# Nilainya di-source oleh deploy.sh dan diteruskan ke PM2 lewat ecosystem.config.cjs.
# Server TIDAK punya .env sendiri di luar yang dikirim deploy.sh.

# ── Sesi ─────────────────────────────────────────────────────────────────────
# Kunci enkripsi cookie sesi, minimal 32 karakter.
# WAJIB beda dari nilai .env pengembangan: siapa pun yang tahu nilai ini bisa
# memalsukan cookie sesi siapa saja, termasuk master.
# Buat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
# Path berkas SQLite di server, relatif terhadap cwd aplikasi (~/ccwebsite).
# Sengaja di luar .output/ supaya `deploy.sh` yang menimpa .output tiap rilis
# tidak pernah menyentuh data produksi.
DATABASE_URL=./data/cc.db
