# Dependencies
node_modules/
.pnpm-store/

# Hasil build & cache Nuxt
.nuxt/
.output/
.nitro/
.cache/
dist/

# Artefak salah ketik: `nuxt dev --port` tanpa nilai membuat folder bernama "--port"
--port/

# Database lokal. Bisa dibangun ulang dari migrasi + `npm run db:seed`,
# dan isinya data pengembangan — tidak perlu ikut ke repo.
data/*.db
data/*.db-shm
data/*.db-wal

# Rahasia. Lihat .env.example untuk daftar kunci yang dibutuhkan.
.env
.env.*
!.env.example

# Rahasia produksi + artefak deploy. Lihat deploy/.env.example.
deploy/.env
deploy/cc.db.snapshot

# Snapshot database produksi (diambil sebelum tiap --migrasi). Isinya seluruh
# situs: akun, email, hash password, dan BLOB media. Tidak pernah boleh ke repo.
backup/

# Log
dev.log
*.log
logs/

# Sistem operasi & editor
.DS_Store
Thumbs.db
.vscode/
.idea/
