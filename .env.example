# Salin berkas ini jadi `.env`, lalu isi nilainya. `.env` tidak ikut ke git.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ── Sesi ─────────────────────────────────────────────────────────────────────
# Kunci enkripsi cookie sesi. Minimal 32 karakter.
# Siapa pun yang tahu nilai ini bisa memalsukan cookie sesi siapa saja, termasuk
# master — jadi nilai produksi tidak boleh sama dengan nilai pengembangan.
# Buat nilai acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# ── Penghitung kunjungan ─────────────────────────────────────────────────────
# Ikut masuk ke dalam hash yang membedakan pengunjung satu dari yang lain.
# Tanpanya dipakai nilai acak yang lahir bersama proses — hitungan "berapa orang"
# jadi terpecah tiap kali server dijalankan ulang.
#
# Yang disimpan hanya hash-nya, dan hash-nya berganti tiap hari dengan sendirinya
# (tanggal ikut masuk ke dalamnya), jadi tidak ada yang bisa dilacak antar hari.
# Buat nilai acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_KUNJUNGAN_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Opsional. Kalau kosong, dipakai ./data/cc.db
# DATABASE_URL=./data/cc.db

# ── Seeder (npm run db:seed) ─────────────────────────────────────────────────
# Password akun pengembangan, satu per role. Dibaca saat seeding lalu langsung
# di-hash dengan scrypt; yang tersimpan di database bukan nilai ini.
# Seeder menolak jalan kalau salah satu kosong.
SEED_MASTER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_USER_PASSWORD=
